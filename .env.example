# VyavaSahayam Fullstack Environment Configuration for Vercel & Local Deployment

# 1. Neon DB (PostgreSQL Connection String)
# Paste your Neon Connection URL from your Neon Console (Connection Details -> Pooled Connection)
DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Security & JWT
SECRET_KEY=vyavasahayam-super-secret-production-jwt-key-change-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# 3. Government Agriculture Market Data APIs (Data.gov.in / Agmarknet)
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001456ec7485a0249c67b45c29519ed076a
AGMARKNET_DAILY_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_VARIETY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# 4. Cashfree Payments
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=your_cashfree_app_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01

# 5. Feature Flags
MOCK_AI=True
MOCK_PAYMENT=False
MOCK_MAPS=True
MOCK_SMS=True
MOCK_VOICE=True
MOCK_DHENU=True
