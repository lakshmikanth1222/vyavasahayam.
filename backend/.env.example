# VyavaSahayam Application Environment Configuration

# Security & Tokens
SECRET_KEY=vyavasahayam-super-secret-production-jwt-key-change-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# Database
# Default: SQLite zero-config local database
# DATABASE_URL=sqlite:///./vyavasahayam.db
# Neon Serverless PostgreSQL (paste your Neon connection string):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./vyavasahayam.db

# Cashfree Payments Configuration
# Set CASHFREE_ENVIRONMENT to "sandbox" for testing or "production" for live payments
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=your_cashfree_app_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key_here
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=http://localhost:5173/payment/callback?order_id={order_id}
CASHFREE_NOTIFY_URL=http://localhost:8000/api/v1/payments/cashfree/webhook

# Government Agriculture Data APIs (Data.gov.in / Agmarknet)
# Get your free API key at https://data.gov.in
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
# Dataset 1: Current Daily Price of Various Commodities from Various Markets (Mandi)
AGMARKNET_DAILY_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Dataset 2: Variety-wise Daily Market Prices Data of Commodity
AGMARKNET_VARIETY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24


# Feature Flags
MOCK_AI=True
MOCK_PAYMENT=False

MOCK_MAPS=True
MOCK_SMS=True
MOCK_VOICE=True
MOCK_DHENU=True
